---
// 一覧・詳細ページの上部。戻るリンク → 小さなラベル → 大きなタイトル → リード文
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  back?: { href: string; label: string };
}

const { eyebrow, title, lead, back } = Astro.props;
---

<header class="page-header">
  {
    back && (
      <a class="back" href={back.href}>
        <span aria-hidden="true">←</span> {back.label}
      </a>
    )
  }
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-header {
    margin-bottom: 48px;
    animation: fade-up 0.8s var(--ease-out) both;
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .back {
    display: inline-flex;
    gap: 6px;
    margin-bottom: 32px;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .back span {
    transition: transform 0.2s var(--ease-out);
  }
  .back:hover {
    color: var(--color-text);
  }
  .back:hover span {
    transform: translateX(-4px);
  }
  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 2.75rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .lead {
    margin: 16px 0 0;
    color: var(--color-muted);
    font-size: 1.125rem;
  }
</style>
