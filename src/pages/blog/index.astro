---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title="Blog | Haru Oba (o1m0)" description="Haru Oba の学習記録やつくったものの記録です。">
  <PageHeader eyebrow="Blog" title="学習と開発の記録" lead="調べたこと、つまずいたこと、作りながら考えたことを書いています。" />
  {posts.length === 0 && <p>まだ記事はありません。</p>}
  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <PostRow post={post} showDescription />
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
</style>
