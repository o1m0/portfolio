---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts } from '../../lib/content';

// 一覧と同じ条件で、本番では下書きのページを作らない
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, publishedAt, updatedAt, tags, relatedWork } = post.data;
// relatedWork は作品の id だけを持っているので、作品のデータを取り出す
const work = relatedWork ? await getEntry(relatedWork) : undefined;
const formatDate = (date: Date) => date.toLocaleDateString('ja-JP');
---

<BaseLayout title={`${title} | Blog | Haru Oba (o1m0)`} description={description}>
  <article>
    <PageHeader eyebrow={formatDate(publishedAt)} title={title} lead={description} back={{ href: '/blog/', label: 'Blog' }}>
      <ul class="meta">
        {tags.map((tag) => <li class="tag">#{tag}</li>)}
        {updatedAt && <li>更新：<time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></li>}
      </ul>
    </PageHeader>

    <div class="prose">
      <Content />
    </div>

    {
      work && (
        <a class="related" href={`/works/${work.id}/`}>
          <span class="related-label">関係する作品</span>
          <span class="related-title">{work.data.title}</span>
          <span class="related-summary">{work.data.summary}</span>
        </a>
      )
    }
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }
  .tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--color-surface);
    font-family: var(--font-mono);
  }
  .related {
    display: block;
    margin-top: 80px;
    padding: 20px 24px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .related:hover {
    border-color: var(--color-accent);
  }
  .related-label {
    display: block;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .related-title {
    display: block;
    margin-top: 4px;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .related-summary {
    display: block;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
</style>
