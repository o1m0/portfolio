---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 一覧と同じ条件で、本番では下書きのページを作らない
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, publishedAt, updatedAt, tags, relatedWork } = post.data;
// relatedWork は作品の id だけを持っているので、作品のデータを取り出す
const work = relatedWork ? await getEntry(relatedWork) : undefined;
---

<BaseLayout title={`${title} | Blog | Haru Oba (o1m0)`} description={description}>
  <article>
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={publishedAt.toISOString()}>{publishedAt.toLocaleDateString('ja-JP')}</time>
      {updatedAt && <>（更新：<time datetime={updatedAt.toISOString()}>{updatedAt.toLocaleDateString('ja-JP')}</time>）</>}
      {tags.map((tag) => <span class="tag">#{tag}</span>)}
    </p>

    <Content />

    {work && (
      <p class="related">関係する作品：<a href={`/works/${work.id}/`}>{work.data.title}</a></p>
    )}
  </article>
</BaseLayout>

<style>
  .meta,
  .related {
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .tag {
    margin-left: 8px;
  }
  .related {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }
</style>
