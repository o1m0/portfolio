---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import WorkCard from '../components/WorkCard.astro';
import { getPosts, getWorks } from '../lib/content';

const skills = [
  { label: '学習中', items: ['Go', 'Linux（Ubuntu Server）'] },
  { label: '大学の授業で使用', items: ['C', 'Java', 'Python'] },
  { label: 'このサイトで使用', items: ['Astro', 'TypeScript', 'Cloudflare Workers'] },
  { label: 'ツール', items: ['Git', 'Tailscale', 'tmux'] },
];

const contacts = [
  { label: 'Email', url: 'mailto:contact@0ba.dev' },
  { label: 'GitHub', url: 'https://github.com/o1m0' },
  { label: 'Zenn', url: 'https://zenn.dev/0ba_dev' },
  { label: 'AtCoder', url: 'https://atcoder.jp/users/O1M0' },
  { label: 'X', url: 'https://x.com/0ba_dev' },
  { label: 'Instagram', url: 'https://www.instagram.com/0ba.dev/' },
];

// 一覧ページと同じ並び順で、新しいものを 3 件だけ出す
const works = (await getWorks()).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout
  title="Haru Oba (o1m0) | Portfolio"
  description="Haru Oba のポートフォリオ。Go のバックエンドエンジニアを目指す学生です。インフラにも興味があり、自宅サーバーを運用しています。作品やブログを載せています。"
  wide
>
  <section class="hero">
    <p class="role fade-up" style="--delay: 0ms">Backend ・ 学生エンジニア</p>
    <h1 class="fade-up" style="--delay: 100ms">Haru Oba<span class="handle">(o1m0)</span></h1>
    <p class="tagline fade-up" style="--delay: 250ms">気になったものには、<br />ぜんぶかじりつく。</p>
    <p class="now fade-up" style="--delay: 400ms">
      <span class="prompt" aria-hidden="true">$</span> now: building homestat in Go<span class="cursor" aria-hidden="true"></span>
    </p>
  </section>

  <section class="section" data-reveal>
    <SectionTitle num="01" title="About" />
    <div class="section-body">
      <p>
        大阪工業大学 情報学部の 3 年生です。Go のバックエンドエンジニアを目指して勉強しています。
        今は、古いノート PC で立てた自宅サーバーを触りながら、Linux やネットワークを学び直しています。
      </p>
    </div>
  </section>

  <section class="section" data-reveal>
    <SectionTitle num="02" title="Skills" />
    <div class="section-body">
      <dl class="skills">
        {
          skills.map((group) => (
            <div class="skill-row">
              <dt>{group.label}</dt>
              <dd>{group.items.join(' / ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" data-reveal>
    <SectionTitle num="03" title="Works" />
    <div class="section-body">
      <ul class="plain">
        {
          works.map((work) => (
            <li>
              <WorkCard work={work} />
            </li>
          ))
        }
      </ul>
      <a class="more" href="/works/">すべての作品 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section" data-reveal>
    <SectionTitle num="04" title="Blog" />
    <div class="section-body">
      <ul class="plain">
        {
          posts.map((post) => (
            <li>
              <a class="post" href={`/blog/${post.id}/`}>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toLocaleDateString('ja-JP')}
                </time>
                <span class="post-title">{post.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="more" href="/blog/">すべての記事 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section" data-reveal>
    <SectionTitle num="05" title="Contact" />
    <div class="section-body">
      <ul class="contacts">
        {
          contacts.map((contact) => (
            <li>
              <a class="pill" href={contact.url}>{contact.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- ヒーロー ---------- */
  .hero {
    padding-block: 64px 120px;
  }
  .hero h1 {
    margin: 16px 0 0;
    font-size: clamp(3.25rem, 13vw, 7rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .handle {
    display: block;
    color: var(--color-muted);
    font-weight: 500;
  }
  .role {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }
  .tagline {
    margin: 40px 0 0;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 500;
    line-height: 1.6;
  }
  .now {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 32px 0 0;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .prompt {
    color: var(--color-accent-text);
  }
  .cursor {
    width: 0.55em;
    height: 1.1em;
    background: var(--color-accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* 開いたときに、上から順に下からふわっと出る（--delay で順番をずらす） */
  .fade-up {
    animation: fade-up 0.9s var(--ease-out) both;
    animation-delay: var(--delay, 0ms);
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* ---------- セクション：PC では見出しを左、中身を右に ---------- */
  .section {
    padding-block: 64px;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .section {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 48px;
      padding-block: 80px;
    }
  }
  .section-body {
    max-width: var(--max-width);
  }
  .section-body > p:first-child {
    margin-top: 0;
  }

  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .more {
    display: inline-flex;
    gap: 6px;
    margin-top: 20px;
    color: var(--color-text);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .more span {
    transition: transform 0.2s var(--ease-out);
  }
  .more:hover span {
    transform: translateX(4px);
  }

  .skills {
    margin: 0;
  }
  .skill-row {
    display: grid;
    grid-template-columns: 9em 1fr;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--color-border);
  }
  .skill-row:first-child {
    border-top: 1px solid var(--color-border);
  }
  .skills dt {
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .skills dd {
    margin: 0;
  }

  .post {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
  }
  .post time {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .post-title {
    transition: color 0.2s;
  }
  .post:hover .post-title {
    color: var(--color-accent-text);
  }

  /* ---------- Contact：角丸のボタン。ホバーで塗りつぶす ---------- */
  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pill {
    display: inline-block;
    padding: 8px 18px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .pill:hover {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }

  @media (max-width: 480px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
